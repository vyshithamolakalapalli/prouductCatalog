@model ProductCatalog.Models.Product
<!DOCTYPE html>
<html>
<head>
    <title>Product Details</title>
</head>
<body>
    <h2>PRODUCT DETAILS</h2>

    <table border="1" cellpadding="6" cellspacing="0">
        <tr><th>Product ID</th><td>@Model.ProductId</td></tr>
        <tr><th>Product Name</th><td>@Model.ProductName</td></tr>
        <tr><th>Category</th><td>@Model.Category</td></tr>
        <tr><th>Price</th><td>₹@Model.Price</td></tr>
        <tr><th>Quantity</th><td>@Model.Quantity</td></tr>
        <tr><th>Description</th><td>@Model.Description</td></tr>
    </table>

    <p>@Html.ActionLink("Back to Product Catalog", "Index")</p>
</body>
</html>
